def grade(score):
    if score > 100 or score < 0:
        print('Invalid score')
    else:
        if score > 80:
            return "A"
        elif score > 70:
            return "B"
        elif score > 60:
            return "C"
        elif score > 50:
            return "D"
        else:
            return "F"
#Input of student 1 
student1 = eval(input('Please enter student Elikem\'s exam score: '))
final_score = grade(student1)
print(f'Elikem\'s Grade: {final_score}')
